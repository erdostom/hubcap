# Copy to .env and fill in clear settings. Private values belong in 1Password.
# The item must contain the five fields listed in README.md.
OP_ACCOUNT=my.1password.com
OP_VAULT=hubcap
OP_ITEM=deployment

HUBCAP_HOST=203.0.113.10
HUBCAP_SSH_USER=root
KAMAL_REGISTRY_SERVER=docker.io
KAMAL_REGISTRY_USERNAME=your-dockerhub-username

SIGNOZ_DOMAIN=signoz.example.com
GLITCHTIP_DOMAIN=glitchtip.example.com
OTEL_DOMAIN=otel.example.com

# ZooKeeper
ZOO_SERVER_ID=1
ALLOW_ANONYMOUS_LOGIN=yes
ZOO_AUTOPURGE_INTERVAL=1
ZOO_ENABLE_PROMETHEUS_METRICS=yes
ZOO_PROMETHEUS_METRICS_PORT_NUMBER=9141

# SigNoz and its collector
SIGNOZ_ALERTMANAGER_PROVIDER=signoz
SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN=tcp://signoz-clickhouse:9000
SIGNOZ_SQLSTORE_SQLITE_PATH=/var/lib/signoz/signoz.db
SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_DSN=tcp://signoz-clickhouse:9000
SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_CLUSTER=cluster
SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_REPLICATION=true
SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_TIMEOUT=10m
OTEL_RESOURCE_ATTRIBUTES=host.name=hubcap,os.type=linux
LOW_CARDINAL_EXCEPTION_GROUPING=false

# GlitchTip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_FROM_EMAIL=noreply@example.com
GLITCHTIP_REDIS_URL=redis://glitchtip-redis:6379/0
CELERY_WORKER_AUTOSCALE=1,3
# Set both to false after creating your first account and organization.
GLITCHTIP_ENABLE_REGISTRATION=true
GLITCHTIP_ENABLE_ORG_CREATION=true
