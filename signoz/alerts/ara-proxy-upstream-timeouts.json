{
  "alert": "ara proxy: upstream timeouts (504)",
  "alertType": "LOGS_BASED_ALERT",
  "schemaVersion": "v2alpha1",
  "version": "v5",
  "ruleType": "threshold_rule",
  "labels": {
    "severity": "critical",
    "service": "ara-webapp",
    "source": "kamal-proxy"
  },
  "annotations": {
    "summary": "arariichi.org is timing out",
    "description": "kamal-proxy returned {{$value}} 504s in the last 5 minutes: the app did not answer within the proxy's target timeout. Last time this was a crawler burst on /users saturating Puma; check the ARA crawler & proxy dashboard (top networks, paths) and the host CPU."
  },
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "logs",
            "stepInterval": "5m",
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "msg = 'Request' AND status = 504"
            }
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 20,
          "targetUnit": "",
          "matchType": "at_least_once",
          "op": "above",
          "channels": [
            "discord-alerts"
          ]
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": true,
      "interval": "1h",
      "alertStates": [
        "firing"
      ]
    }
  }
}
