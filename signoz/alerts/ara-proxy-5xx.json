{
  "alert": "ara proxy: 5xx responses (other than 504)",
  "alertType": "LOGS_BASED_ALERT",
  "schemaVersion": "v2alpha1",
  "version": "v5",
  "ruleType": "threshold_rule",
  "labels": {
    "severity": "warning",
    "service": "ara-webapp",
    "source": "kamal-proxy"
  },
  "annotations": {
    "summary": "arariichi.org is returning server errors at the proxy",
    "description": "kamal-proxy logged {{$value}} responses with status 500-599 other than 504 in the last 5 minutes. The app's trace-based 5xx rule needs the request to reach Rails; this catches errors from the proxy itself and failed response writes (which kamal-proxy logs as 500 - one slow client fetching 40 assets at once did that on 2026-11-01)."
  },
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "logs",
            "stepInterval": "5m",
            "aggregations": [
              {
                "expression": "count()"
              }
            ],
            "filter": {
              "expression": "msg = 'Request' AND status >= 500 AND status != 504"
            }
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "target": 10,
          "targetUnit": "",
          "matchType": "at_least_once",
          "op": "above",
          "channels": [
            "discord-alerts"
          ]
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": true,
      "interval": "1h",
      "alertStates": [
        "firing"
      ]
    }
  }
}
