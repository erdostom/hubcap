# =============================================================================
# Hubcap — Kamal secrets
# Copy to .kamal/secrets and fill in:  cp .kamal/secrets.example .kamal/secrets
# (.kamal/secrets is gitignored)
#
# The server host and domains are set in config/deploy.yml (they are not
# secret); everything below belongs in .kamal/secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# Docker Hub — free account is enough; avoids anonymous pull rate limits
# ---------------------------------------------------------------------------
KAMAL_REGISTRY_USERNAME=your-dockerhub-username
KAMAL_REGISTRY_PASSWORD=your-dockerhub-password-or-token

# ---------------------------------------------------------------------------
# SigNoz
# ---------------------------------------------------------------------------
# Random secret used to sign JWT tokens for the SigNoz UI
# Generate with: openssl rand -hex 32
SIGNOZ_TOKENIZER_JWT_SECRET=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# GlitchTip
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-string

# GlitchTip database — password must be URL-safe (no spaces or special
# characters) since it is embedded in this URL
DATABASE_URL=postgres://glitchtip:changeme@glitchtip-db:5432/glitchtip
POSTGRES_PASSWORD=changeme

# Email (consolemail:// prints to stdout — replace with smtp:// for real email)
GLITCHTIP_EMAIL_URL=consolemail://
